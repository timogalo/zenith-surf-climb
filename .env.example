# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings → API). Never commit .env.local.

# Public Supabase project URL. Safe to expose to the browser — used both
# as the server's connection URL and reserved for any future client-side
# Supabase usage.
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe to expose to the browser. Not used by the booking
# backend yet (the browser never talks to Supabase directly — see
# docs/booking-backend.md) — reserved for future client-side access under
# a narrow RLS policy, if one is ever added.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service-role key. NEVER prefix this with NEXT_PUBLIC_ and
# never import it into a Client Component — it bypasses Row Level
# Security entirely. Used only by src/lib/supabase/server.ts, which is
# only ever called from API route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 2: booking notifications (Resend) ---------------------------

# Server-only Resend API key, from https://resend.com/api-keys. Used only
# by src/lib/email/resend.ts. Never expose to the browser.
RESEND_API_KEY=

# Where new-booking notification emails (with Approve/Reject links) are
# sent. This is the owner's real inbox address — not a Resend setting.
BOOKING_OWNER_EMAIL=

# Strong random server-only secret used to HMAC-sign Approve/Reject action
# links. Generate one with: openssl rand -base64 32
# Must be at least 32 characters — src/lib/booking/action-token.ts refuses
# to sign/verify tokens with a shorter value, to prevent an accidentally
# weak secret from being usable. Never commit a real value. Rotating it
# invalidates all outstanding (unclicked) action links.
BOOKING_ACTION_SECRET=

# Canonical public site URL used to build Approve/Reject links embedded in
# owner emails, and as the metadata/SEO canonical domain (see
# src/app/layout.tsx, robots.ts, sitemap.ts). Locally: http://localhost:3000
# (no trailing slash). Production: https://zenithnomads.com
NEXT_PUBLIC_SITE_URL=

# Optional. Overrides the sender for all transactional booking emails.
# zenithnomads.com is now verified in Resend, so leaving this unset already
# defaults to "Zenith Nomads <bookings@zenithnomads.com>" (see
# src/lib/email/resend.ts) — only set this if you need a different sender,
# e.g. Resend's shared testing sender (onboarding@resend.dev) for local
# testing without emailing real inboxes. See docs/booking-backend.md.
BOOKING_FROM_EMAIL=

# --- Phase 3: rate limiting (Upstash Redis) -----------------------------

# Optional but recommended in production. REST credentials for an Upstash
# Redis database (upstash.com — free tier is sufficient), used by
# src/lib/rate-limit/upstash.ts to rate-limit POST /api/bookings and
# POST /api/booking-action across serverless invocations. If either value
# is missing, rate limiting is skipped entirely (fails open) rather than
# blocking the booking form — see docs/booking-backend.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Phase 4: admin dashboard (/admin) ----------------------------------

# Server-only, secret. BOOTSTRAP-ONLY as of Phase 5 (self-service change
# password): a salted scrypt hash of the admin password, format
# "<saltHex>:<hashHex>". The first time src/lib/admin/credentials.ts reads
# the (empty) admin_credentials Supabase table, it seeds one row from this
# value, then never reads it again — from then on, the admin_credentials
# table is the live source of truth, and the admin changes her password
# from /admin/settings, not by editing this variable. Still required for
# that one-time bootstrap. NEVER put the real hash (or the plaintext
# password) in this file or any committed file — generate it locally and
# set it directly in Vercel / .env.local. See docs/admin-dashboard.md for
# the exact generation command and the migration that creates the table
# (supabase/migrations/0002_admin_credentials.sql).
ADMIN_PASSWORD_HASH=

# Server-only, secret. Strong random value (>=32 chars) used to sign the
# admin session cookie (HMAC-SHA256), separate from BOOKING_ACTION_SECRET
# so rotating one never invalidates the other. Generate with:
# openssl rand -base64 32
ADMIN_SESSION_SECRET=
